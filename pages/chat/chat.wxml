<view class="page">
  <view class="toolbar" style="padding-top: {{statusBarHeight}}px; padding-right: {{capsuleGap}}px;">
    <view class="toolbar-inner" style="height: {{navBarHeight}}px;">
      <view class="toolbar-brand">
        <view class="toolbar-kicker">XINGTU</view>
        <text class="toolbar-title">照明客服</text>
      </view>
      <view class="toolbar-actions">
        <view class="link" bindtap="onClear">清空</view>
      </view>
    </view>
  </view>

  <scroll-view class="list" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:if="{{!messages.length}}" class="empty">
      <image class="lamp" src="/assets/xingtu-logo.jpg" mode="aspectFit" />
      <text class="empty-title">星途照明客服</text>
      <text class="empty-hint">可以问问柱头灯、壁灯，或查一下订单</text>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="row {{item.role === 'user' ? 'row-user' : 'row-bot'}}"
    >
      <view class="avatar">
        <image
          class="avatar-img"
          src="{{item.role === 'user' ? myAvatar : botAvatar}}"
          mode="aspectFill"
          binderror="onAvatarError"
        />
      </view>
      <view class="bubble-wrap">
        <view class="meta" wx:if="{{item.role !== 'user'}}">
          <text class="tag {{item.role === 'staff' ? 'tag-human' : 'tag-ai'}}">{{item.role === 'staff' ? '人工客服' : '智能客服'}}</text>
        </view>
        <view class="bubble {{item.streaming && !item.content ? 'typing' : ''}}">{{item.content || (item.streaming ? '客服正在回复…' : '')}}</view>
        <view wx:if="{{item.product_cards && item.product_cards.length}}" class="cards">
          <view
            wx:for="{{item.product_cards}}"
            wx:for-item="card"
            wx:key="product_id"
            class="card"
            data-id="{{card.product_id}}"
            bindtap="openProduct"
          >
            <image wx:if="{{card.coverSrc}}" class="card-cover" src="{{card.coverSrc}}" mode="aspectFill" />
            <view wx:else class="card-cover card-cover-empty"></view>
            <view class="card-body">
              <view class="card-title">{{card.title}}</view>
              <view class="card-price">¥{{card.price}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view id="bottom" class="bottom-anchor"></view>
  </scroll-view>

  <view class="tips" wx:if="{{messages.length <= 1 && !sending}}">
    <view class="chip" bindtap="onChip" data-text="给我推荐一下">推荐灯具</view>
    <view class="chip" bindtap="onChip" data-text="给我推荐一个壁灯">户外壁灯</view>
    <view class="chip" bindtap="onChip" data-text="柱头灯多少钱">柱头灯</view>
  </view>

  <view class="composer safe-bottom">
    <input
      class="input"
      value="{{draft}}"
      confirm-type="send"
      placeholder="问问灯具、订单或售后"
      bindinput="onDraft"
      bindconfirm="onSend"
    />
    <button class="send" disabled="{{sending || !draft}}" bindtap="onSend">发送</button>
  </view>
</view>
