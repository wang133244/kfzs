.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f3eee4;
}

.toolbar {
  flex-shrink: 0;
  z-index: 20;
  padding: 0 28rpx 0 28rpx;
  background: #1b2a4a;
  color: #fffcf7;
  box-sizing: border-box;
}

.toolbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.toolbar-brand {
  min-width: 0;
  flex: 1;
}

.toolbar-kicker {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #e0c36a;
}

.toolbar-title {
  font-size: 30rpx;
  font-weight: 600;
}

.toolbar-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 8rpx;
}

.link {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: #e0c36a;
}

.list {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  padding-top: 80rpx;
  text-align: center;
  color: #78716c;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.lamp {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 12rpx;
  border-radius: 28rpx;
  background: #000;
  box-shadow: 0 12rpx 32rpx rgba(196, 163, 90, 0.28);
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #e6dfd2;
  border: 1rpx solid #e6dfd2;
  flex-shrink: 0;
}

.avatar-img {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b2a4a;
}

.empty-hint {
  font-size: 22rpx;
  color: #a8a29e;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.row-user {
  flex-direction: row-reverse;
}

.row-user .avatar {
  border-color: #e6dfd2;
}

.bubble-wrap {
  max-width: 72%;
}

.meta {
  margin-bottom: 8rpx;
}

.row-user .meta {
  text-align: right;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
}

.tag-ai {
  background: #f6e7b8;
  color: #1b2a4a;
}

.tag-human {
  background: #1b2a4a;
  color: #e0c36a;
}

.bubble {
  padding: 18rpx 22rpx;
  border-radius: 8rpx 22rpx 22rpx 22rpx;
  background: #fffcf7;
  color: #1c1917;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  border: 1rpx solid #e6dfd2;
}

.row-user .bubble {
  background: #1b2a4a;
  color: #fffcf7;
  border-color: #1b2a4a;
  border-radius: 22rpx 8rpx 22rpx 22rpx;
}

.typing {
  color: #78716c;
}

.cards {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card {
  display: flex;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fffcf7;
  border: 1rpx solid #e6dfd2;
}

.card-cover {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  background: #e6dfd2;
}

.card-cover-empty {
  background: linear-gradient(180deg, #f6e7b8, #c4a35a);
}

.card-body {
  padding: 16rpx;
  min-width: 0;
}

.card-title {
  font-size: 24rpx;
  color: #1c1917;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-price {
  margin-top: 8rpx;
  color: #a16207;
  font-size: 26rpx;
  font-weight: 700;
}

.bottom-anchor {
  height: 8rpx;
}

.tips {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 12rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: #fffcf7;
  border: 1rpx solid #e6dfd2;
  color: #1b2a4a;
  font-size: 22rpx;
}

.composer {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 24rpx 24rpx;
  background: #fffcf7;
  border-top: 1rpx solid #e6dfd2;
}

.input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e6dfd2;
  border-radius: 38rpx;
  background: #f3eee4;
  font-size: 28rpx;
}

.send {
  width: 140rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 38rpx;
  background: #1b2a4a;
  color: #e0c36a;
  font-size: 26rpx;
  font-weight: 600;
}

.send::after {
  border: none;
}

.send[disabled] {
  background: #d6d3d1;
  color: #fff;
}
