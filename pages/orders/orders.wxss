.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #fffcf7;
  border-radius: 20rpx;
  border: 1rpx solid #e6dfd2;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.oid {
  font-size: 26rpx;
  font-weight: 700;
  color: #1b2a4a;
}

.status {
  color: #c4a35a;
  font-size: 22rpx;
  font-weight: 600;
}

.line {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  color: #57534e;
  font-size: 24rpx;
}

.line-title {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.foot {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f3eee4;
}

.time {
  color: #a8a29e;
  font-size: 22rpx;
}

.amount {
  color: #a16207;
  font-weight: 700;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #a8a29e;
}
