<view class="page">
  <view class="night">
    <view class="glow"></view>
    <view class="logo-wrap">
      <image class="logo" src="/assets/xingtu-logo.jpg" mode="aspectFit" />
    </view>
    <view class="brand-en">XINGTU LIGHTING</view>
    <view class="title">星途户外照明</view>
    <view class="sub">点亮庭院与归途</view>
  </view>

  <view class="card">
    <button class="btn wx" loading="{{wxLoading}}" disabled="{{wxLoading || loading}}" bindtap="onWechatLogin">
      {{wxLoading ? '微信登录中…' : '微信一键登录'}}
    </button>
    <view class="split">或使用账号密码</view>
    <view class="label">用户名</view>
    <input class="input" value="{{username}}" placeholder="请输入用户名" bindinput="onUsername" />
    <view class="label">密码</view>
    <input class="input" password value="{{password}}" placeholder="请输入密码" bindinput="onPassword" />
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="btn" loading="{{loading}}" disabled="{{loading || wxLoading}}" bindtap="onSubmit">
      {{loading ? '登录中…' : '账号登录'}}
    </button>
    <view class="skip" bindtap="onBrowseShop">先去逛橱窗，登录后再下单</view>
  </view>
</view>
