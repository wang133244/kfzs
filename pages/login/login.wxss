.page {
  min-height: 100vh;
  padding: 0 40rpx 80rpx;
  background: #f3eee4;
  box-sizing: border-box;
}

.night {
  position: relative;
  margin: 0 -40rpx 48rpx;
  padding: 88rpx 48rpx 56rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #0e1628 0%, #1b2a4a 72%, #243656 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.glow {
  position: absolute;
  top: 36rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(224, 195, 106, 0.45) 0%, rgba(196, 163, 90, 0.08) 42%, transparent 70%);
}

.logo-wrap {
  position: relative;
  z-index: 1;
}

.logo {
  width: 280rpx;
  height: 280rpx;
  border-radius: 28rpx;
  background: #000;
  box-shadow: 0 16rpx 48rpx rgba(196, 163, 90, 0.28);
}

.brand-en {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  letter-spacing: 6rpx;
  font-size: 20rpx;
  color: #e0c36a;
}

.title {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.sub {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 252, 247, 0.72);
}

.card {
  background: #fffcf7;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 18rpx 50rpx rgba(27, 42, 74, 0.08);
  border: 1rpx solid #e6dfd2;
}

.label {
  font-size: 24rpx;
  color: #78716c;
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid #e6dfd2;
  border-radius: 16rpx;
  background: #fff;
  font-size: 28rpx;
}

.error {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff1f2;
  color: #b91c1c;
  font-size: 24rpx;
}

.btn {
  margin-top: 8rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #1b2a4a;
  color: #f6e7b8;
  font-size: 30rpx;
  font-weight: 600;
}

.btn.wx {
  margin-top: 0;
  background: #07c160;
  color: #fff;
}

.btn::after {
  border: none;
}

.split {
  margin: 36rpx 0 24rpx;
  text-align: center;
  color: #a8a29e;
  font-size: 22rpx;
}

.skip {
  margin-top: 28rpx;
  text-align: center;
  color: #c4a35a;
  font-size: 26rpx;
}
