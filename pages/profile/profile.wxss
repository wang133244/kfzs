.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f3eee4;
}

.hero {
  display: flex;
  align-items: center;
  padding: 36rpx 28rpx;
  background: linear-gradient(145deg, #121b33 0%, #1b2a4a 55%, #3d4d73 100%);
  border-radius: 28rpx;
  color: #fffcf7;
  box-shadow: 0 16rpx 40rpx rgba(27, 42, 74, 0.18);
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: 1;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #c4a35a;
  border: 4rpx solid rgba(224, 195, 106, 0.8);
}

.avatar-tip {
  margin-top: 8rpx;
  text-align: center;
  font-size: 20rpx;
  color: #e0c36a;
}

.name-wrap {
  margin-left: 24rpx;
  min-width: 0;
  flex: 1;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.name-input {
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 32rpx;
}

.meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 252, 247, 0.7);
  line-height: 1.5;
}

.card {
  margin-top: 24rpx;
  background: #fffcf7;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #e6dfd2;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #f3eee4;
}

.row:last-child {
  border-bottom: none;
}

.row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.row-sub {
  margin-top: 8rpx;
  color: #a8a29e;
  font-size: 22rpx;
}

.row-right {
  color: #a16207;
  font-size: 30rpx;
  font-weight: 700;
}

.arrow {
  font-weight: 500;
  font-size: 26rpx;
  color: #a8a29e;
}

.logout {
  margin-top: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fffcf7;
  color: #b91c1c;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: 1rpx solid #e6dfd2;
}
