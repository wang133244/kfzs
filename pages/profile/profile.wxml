<view class="page">
  <view class="hero">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatar}}" mode="aspectFill" />
      <view class="avatar-tip">更换头像</view>
    </button>
    <view class="name-wrap">
      <view wx:if="{{!editing}}" class="name" bindtap="startEdit">{{username}}</view>
      <input
        wx:else
        class="name-input"
        type="nickname"
        maxlength="32"
        value="{{draftName}}"
        placeholder="输入用户名"
        bindinput="onDraftName"
        bindblur="saveName"
      />
      <view class="meta">{{isAdmin ? '管理员账号' : (loginType === 'wechat' ? '微信登录' : '测试账号')}} · 点击头像或用户名可修改</view>
    </view>
  </view>

  <view class="card">
    <view class="row" bindtap="goWallet">
      <view>
        <view class="row-title">我的钱包</view>
        <view class="row-sub">虚拟余额，下单扣款</view>
      </view>
      <view class="row-right">¥{{wallet}}</view>
    </view>
    <view class="row" bindtap="goOrders">
      <view>
        <view class="row-title">订单查询</view>
        <view class="row-sub">查看已生成的订单</view>
      </view>
      <view class="row-right arrow">查看</view>
    </view>
  </view>

  <view class="logout" catchtap="logout">退出登录</view>

  <admin-tabbar wx:if="{{isAdmin}}" current="me" />
</view>
