<view class="page" wx:if="{{product}}">
  <image wx:if="{{product.coverSrc}}" class="hero" src="{{product.coverSrc}}" mode="aspectFill" />
  <view wx:else class="hero hero-empty"></view>

  <view class="panel">
    <view class="price">¥{{product.price}}</view>
    <view wx:if="{{product.original_price && product.original_price > product.price}}" class="origin">
      ¥{{product.original_price}}
    </view>
    <view class="title">{{product.title}}</view>
    <view class="sub">{{product.subtitle}}</view>
    <view class="tags">
      <text wx:for="{{product.tags}}" wx:key="*this" class="tag">{{item}}</text>
    </view>
  </view>

  <view class="panel" wx:if="{{product.description}}">
    <view class="h">商品介绍</view>
    <view class="desc">{{product.description}}</view>
  </view>

  <view class="panel" wx:if="{{product.specs && product.specs.length}}">
    <view class="h">规格参数</view>
    <view wx:for="{{product.specs}}" wx:key="label" class="spec">
      <text class="spec-k">{{item.label}}</text>
      <text class="spec-v">{{item.value}}</text>
    </view>
  </view>

  <view class="bottom safe-bottom" wx:if="{{isAdmin}}">
    <button class="ghost" bindtap="onEdit">编辑</button>
    <button class="ghost" bindtap="onToggleShelf">{{product.status === 'off_shelf' ? '上架' : '下架'}}</button>
    <button class="danger" bindtap="onDelete">删除</button>
  </view>
  <view class="bottom safe-bottom" wx:else>
    <button class="ghost" bindtap="askCs">问客服</button>
    <button class="ghost" bindtap="addCart">加购物车</button>
    <button class="primary" bindtap="openSource">原网址查看</button>
  </view>
</view>

<view wx:elif="{{loading}}" class="status">加载中…</view>
<view wx:else class="status error">{{error}}</view>
