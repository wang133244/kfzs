<view class="page">
  <view class="search-bar">
    <input
      class="search"
      value="{{keyword}}"
      placeholder="搜索用户名或订单号"
      confirm-type="search"
      bindinput="onKeyword"
      bindconfirm="search"
    />
    <text class="search-btn" bindtap="search">查询</text>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{error}}" class="empty error">{{error}}</view>
  <view wx:elif="{{!orders.length}}" class="empty">没有找到订单</view>

  <view wx:else class="list">
    <view wx:for="{{orders}}" wx:key="order_id" class="card">
      <view class="head">
        <text class="name">{{item.display_name}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="product">{{item.product}}</view>
      <view class="foot">
        <text class="time">{{item.timeText}}</text>
        <text class="amount">¥{{item.amountText}}</text>
      </view>
    </view>
  </view>

  <admin-tabbar current="orders" />
</view>
