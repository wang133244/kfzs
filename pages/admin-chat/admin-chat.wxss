.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f3eee4;
}

.hint-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff8e8;
  border-bottom: 1rpx solid #e6dfd2;
}

.hint {
  flex: 1;
  font-size: 22rpx;
  color: #78716c;
  line-height: 1.5;
}

.close {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #b91c1c;
}

.list {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.empty {
  padding-top: 80rpx;
  text-align: center;
  color: #a8a29e;
  font-size: 26rpx;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.row-mine {
  flex-direction: row-reverse;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #e6dfd2;
  flex-shrink: 0;
}

.avatar-img {
  width: 72rpx;
  height: 72rpx;
  display: block;
}

.bubble-wrap {
  max-width: 72%;
}

.meta {
  margin-bottom: 8rpx;
}

.row-mine .meta {
  text-align: right;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
}

.tag-ai {
  background: #f6e7b8;
  color: #1b2a4a;
}

.tag-human {
  background: #1b2a4a;
  color: #e0c36a;
}

.tag-user {
  background: #e6dfd2;
  color: #57534e;
}

.bubble {
  padding: 18rpx 22rpx;
  border-radius: 8rpx 22rpx 22rpx 22rpx;
  background: #fffcf7;
  color: #1c1917;
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  border: 1rpx solid #e6dfd2;
}

.row-mine .bubble {
  background: #1b2a4a;
  color: #fffcf7;
  border-color: #1b2a4a;
  border-radius: 22rpx 8rpx 22rpx 22rpx;
}

.bottom-anchor {
  height: 8rpx;
}

.composer {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #fffcf7;
  border-top: 1rpx solid #e6dfd2;
}

.input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e6dfd2;
  border-radius: 38rpx;
  background: #f3eee4;
  font-size: 28rpx;
}

.send {
  width: 140rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 38rpx;
  background: #1b2a4a;
  color: #e0c36a;
  font-size: 26rpx;
  font-weight: 600;
}

.send::after {
  border: none;
}

.send[disabled] {
  background: #d6d3d1;
  color: #fff;
}
