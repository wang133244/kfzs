.page {
  padding-bottom: 40rpx;
}

.page.admin-pad {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.brand {
  padding: 16rpx 28rpx 4rpx;
  background: #1b2a4a;
  color: #fffcf7;
}

.brand-en {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: #e0c36a;
}

.brand-sub {
  margin-top: 6rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 252, 247, 0.65);
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #1b2a4a;
}

.search {
  flex: 1;
  height: 72rpx;
  padding: 0 28rpx;
  background: rgba(255, 252, 247, 0.12);
  color: #fffcf7;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.search-btn {
  color: #e0c36a;
  font-size: 26rpx;
  font-weight: 600;
}

.search-ph {
  color: rgba(255, 252, 247, 0.45);
}

.cats {
  white-space: nowrap;
  background: #1b2a4a;
  padding: 0 16rpx 20rpx;
}

.cat {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 252, 247, 0.08);
  color: rgba(255, 252, 247, 0.75);
  font-size: 24rpx;
}

.cat-on {
  background: #c4a35a;
  color: #1b2a4a;
  font-weight: 600;
}

.status {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #a8a29e;
}

.error {
  color: #b91c1c;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 12rpx;
}

.item {
  width: 50%;
  padding: 8rpx;
  box-sizing: border-box;
  position: relative;
}

.item-off {
  opacity: 0.62;
}

.off-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(27, 42, 74, 0.82);
  color: #fffcf7;
  font-size: 20rpx;
}

.cover {
  width: 100%;
  height: 280rpx;
  background: #e6dfd2;
  border-radius: 20rpx 20rpx 0 0;
}

.cover-empty {
  background: linear-gradient(180deg, #f6e7b8, #c4a35a);
  color: #1b2a4a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
}

.meta {
  padding: 16rpx;
  background: #fffcf7;
  border-radius: 0 0 20rpx 20rpx;
  border: 1rpx solid #e6dfd2;
  border-top: none;
}

.name {
  height: 72rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #1c1917;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  color: #a16207;
  font-size: 28rpx;
  font-weight: 700;
}

.add {
  font-size: 22rpx;
  color: #1b2a4a;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #f6e7b8;
  font-weight: 600;
}
