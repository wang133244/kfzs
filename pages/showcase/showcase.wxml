<view class="page">
  <view class="brand">
    <view class="brand-en">XINGTU SHOWCASE</view>
    <view class="brand-sub">柱头灯 · 户外壁灯 · 庭院灯</view>
  </view>

  <view class="search-bar">
    <input
      class="search"
      value="{{keyword}}"
      placeholder="搜索柱头灯 / 壁灯 / 庭院灯"
      placeholder-class="search-ph"
      confirm-type="search"
      bindinput="onKeyword"
      bindconfirm="onSearch"
    />
    <text class="search-btn" bindtap="onSearch">搜索</text>
  </view>

  <scroll-view class="cats" scroll-x>
    <view
      wx:for="{{categories}}"
      wx:key="code"
      class="cat {{activeCategory === item.code ? 'cat-on' : ''}}"
      data-code="{{item.code}}"
      bindtap="onCategory"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="status">加载中…</view>
  <view wx:elif="{{error}}" class="status error">{{error}}</view>
  <view wx:elif="{{!products.length}}" class="status">暂无商品</view>

  <view class="grid">
    <view
      wx:for="{{products}}"
      wx:key="product_id"
      class="item"
      data-id="{{item.product_id}}"
      bindtap="openDetail"
    >
      <image wx:if="{{item.cover}}" class="cover" src="{{item.cover}}" mode="aspectFill" />
      <view wx:else class="cover cover-empty">灯</view>
      <view class="meta">
        <view class="name">{{item.title}}</view>
        <view class="row">
          <text class="price">¥{{item.price}}</text>
          <text class="add" catchtap="addCart" data-id="{{item.product_id}}">加购</text>
        </view>
      </view>
    </view>
  </view>
</view>
