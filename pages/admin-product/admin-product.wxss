.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f3eee4;
}

.cover-box {
  overflow: hidden;
  border-radius: 20rpx;
  background: #e6dfd2;
}

.cover {
  width: 100%;
  height: 360rpx;
}

.cover.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #78716c;
  font-size: 28rpx;
  background: linear-gradient(180deg, #f6e7b8, #c4a35a);
  color: #1b2a4a;
  font-weight: 600;
}

.card {
  margin-top: 24rpx;
  padding: 8rpx 28rpx 28rpx;
  background: #fffcf7;
  border-radius: 20rpx;
  border: 1rpx solid #e6dfd2;
}

.label {
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  color: #78716c;
  font-size: 24rpx;
}

.input,
.picker {
  height: 80rpx;
  padding: 0 20rpx;
  line-height: 80rpx;
  background: #f3eee4;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  background: #f3eee4;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.save {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #1b2a4a;
  color: #e0c36a;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.save::after {
  border: none;
}
