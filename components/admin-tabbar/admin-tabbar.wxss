.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fffcf7;
  border-top: 1rpx solid #e6dfd2;
}

.item {
  flex: 1;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8b8378;
  font-size: 20rpx;
}

.item.on {
  color: #c4a35a;
}

.icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}
